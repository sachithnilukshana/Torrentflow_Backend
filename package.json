    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "magnet-uri": "^7.0.5",
    "multer": "^1.4.5-lts.1",
    "node-telegram-bot-api": "^0.66.0",
    "socket.io": "^4.8.1",
    "webtorrent": "^3.0.21"
