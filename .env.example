PORT=3000
# Set to your deployed Vercel frontend URL, comma-separated if multiple
FRONTEND_ORIGIN=https://torrentflowfronteend.vercel.app,http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
DOWNLOAD_PATH=./downloads
TEMP_DOWNLOAD_PATH=./temp-downloads
MOVIE_CATALOGUE_PATH=./movie-catalogue.json
# BitTorrent Network Port (Open TCP & UDP on Oracle Cloud firewall for 50-80 MB/s speed)
TORRENT_PORT=6881
DHT_PORT=6881
MAX_CONNECTIONS=1000
TORRENT_STRATEGY=rarest
STORE_CACHE_SLOTS=128

MAX_ACTIVE_TORRENTS=3
MAX_CONNECTIONS=500
MAX_TORRENT_UPLOAD_MB=5
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=
# Optional, for a custom public B2 URL. The bucket must permit browser downloads.
B2_PUBLIC_URL_BASE=
AUTO_UPLOAD_TO_BACKBLAZE_B2=true
B2_UPLOAD_MAX_ATTEMPTS=5
B2_RETRY_DELAY_SECONDS=10

B2_PART_SIZE_MIB=64
B2_PARALLEL_PARTS=6
DELETE_TEMP_AFTER_B2_UPLOAD=true
B2_RETENTION_DAYS=2

